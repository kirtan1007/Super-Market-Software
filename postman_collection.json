          "raw": "{\n    \"email\": \"owner@supermarket.com\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/send-otp",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "auth",
            "send-otp"
          ]
